<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarkodListem.LoginPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6F9">

    <ScrollView>
        <Grid RowDefinitions="350,Auto" MinimumHeightRequest="760">
            <Grid Grid.Row="0" Padding="28,34,28,58">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#071C2E" Offset="0.0" />
                        <GradientStop Color="#0C3D5B" Offset="0.58" />
                        <GradientStop Color="#087E84" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Border WidthRequest="190" HeightRequest="190"
                        Stroke="#22FFFFFF" StrokeThickness="2"
                        BackgroundColor="#08FFFFFF"
                        HorizontalOptions="End" VerticalOptions="Start"
                        TranslationX="82" TranslationY="-70">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="95" />
                    </Border.StrokeShape>
                </Border>
                <Border WidthRequest="125" HeightRequest="125"
                        Stroke="#18FFFFFF" StrokeThickness="2"
                        BackgroundColor="#06FFFFFF"
                        HorizontalOptions="Start" VerticalOptions="End"
                        TranslationX="-72" TranslationY="22">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="63" />
                    </Border.StrokeShape>
                </Border>

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Border WidthRequest="132" HeightRequest="132"
                            Padding="11" Stroke="#55FFFFFF"
                            StrokeThickness="1" BackgroundColor="#F7FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#CC00101D" Opacity="0.40" Radius="18" Offset="0,8" />
                        </Border.Shadow>
                        <Image x:Name="brandLogo" Source="brand_logo.png" Aspect="AspectFit" />
                    </Border>
                    <Label Text="MOBİL SERVİS" TextColor="White"
                           FontSize="28" FontAttributes="Bold"
                           CharacterSpacing="2.2" HorizontalTextAlignment="Center" />
                    <Label Text="Sevkiyat ve saha işlemleri"
                           TextColor="#CBE5EB" FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Grid.Row="1" Margin="22,-42,22,28" Spacing="18">
                <Border Padding="24,24,24,26" Stroke="#E2E8EE"
                        StrokeThickness="1" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#2D263849" Opacity="0.24" Radius="22" Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="17">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Hoş geldiniz" TextColor="#102A3A"
                                   FontSize="24" FontAttributes="Bold" />
                            <Label Text="Devam etmek için hesabınızla giriş yapın."
                                   TextColor="#6C7D89" FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="KULLANICI ADI" TextColor="#456170"
                                   FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.1" />
                            <Border Padding="14,3" HeightRequest="56"
                                    Stroke="#D6E0E6" StrokeThickness="1"
                                    BackgroundColor="#F7F9FB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Entry x:Name="usernameEntry"
                                       Placeholder="Kullanıcı adınızı yazın"
                                       PlaceholderColor="#9AA9B3" TextColor="#102A3A"
                                       BackgroundColor="Transparent" FontSize="16"
                                       ReturnType="Next" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="ŞİFRE" TextColor="#456170"
                                   FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1.1" />
                            <Border Padding="14,3" HeightRequest="56"
                                    Stroke="#D6E0E6" StrokeThickness="1"
                                    BackgroundColor="#F7F9FB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Entry x:Name="passwordEntry"
                                       Placeholder="Şifrenizi yazın"
                                       PlaceholderColor="#9AA9B3" TextColor="#102A3A"
                                       BackgroundColor="Transparent" FontSize="16"
                                       IsPassword="True" ReturnType="Go"
                                       Completed="OnLoginClicked" />
                            </Border>
                        </VerticalStackLayout>

                        <Label x:Name="errorLabel" TextColor="#C62828"
                               BackgroundColor="#FFF0F0" Padding="12,9"
                               FontSize="13" HorizontalTextAlignment="Center"
                               IsVisible="False" />

                        <Button x:Name="loginButton" Text="GİRİŞ YAP"
                                Clicked="OnLoginClicked" HeightRequest="56"
                                CornerRadius="14" FontSize="16"
                                FontAttributes="Bold" CharacterSpacing="1.0"
                                TextColor="White" BackgroundColor="#087E84" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border WidthRequest="8" HeightRequest="8" StrokeThickness="0"
                            BackgroundColor="#20A36A">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                    </Border>
                    <Label Text="Güvenli web servis bağlantısı"
                           TextColor="#71828D" FontSize="12"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
