<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="BarkodListem.Popups.ProgressPopup"
               WidthRequest="340" HeightRequest="360">
    <Border Padding="20" Stroke="#DDE6EB" StrokeThickness="1" BackgroundColor="White">
        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
        <VerticalStackLayout Spacing="15">
            <VerticalStackLayout Spacing="3"><Label Text="İŞLEM DEVAM EDİYOR" TextColor="#087E84" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.1"/><Label Text="Veriler gönderiliyor" TextColor="#102A3A" FontSize="20" FontAttributes="Bold"/><Label Text="Lütfen bu pencereyi kapatmayın." TextColor="#7B8D98" FontSize="11"/></VerticalStackLayout>
            <ProgressBar x:Name="progressBar" Progress="0" HeightRequest="8" ProgressColor="#087E84" BackgroundColor="#E1ECEF"/>
            <CollectionView x:Name="stepsCollectionView" HeightRequest="190" ItemsSource="{Binding Steps}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*,Auto" Padding="2,6" ColumnSpacing="9"><Border WidthRequest="8" HeightRequest="8" StrokeThickness="0" BackgroundColor="#40D69C" VerticalOptions="Center"><Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape></Border><Label Grid.Column="1" Text="{Binding Text}" FontSize="12" TextColor="#294654" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="{Binding Status}" FontSize="15" TextColor="#1BAA72" FontAttributes="Bold"/></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
            <Button x:Name="btnTamam" Text="TAMAM" IsEnabled="False" Clicked="btnTamam_Clicked" HeightRequest="48" CornerRadius="14" BackgroundColor="#087E84" TextColor="White" FontAttributes="Bold"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
