<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BarkodListem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BarkodListem"
    Shell.FlyoutBehavior="Disabled"
    Title="Mobil Servis"
    Shell.NavBarHasShadow="False"
    Shell.BackgroundColor="#071C2E"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.DisabledColor="#78909C"
    Shell.UnselectedColor="#9FC9D2"
    Shell.TabBarBackgroundColor="#071C2E"
    Shell.TabBarTitleColor="#34D1C6"
    Shell.TabBarUnselectedColor="#9FC9D2">
    <ShellContent
        Title="Ana Sayfa"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
</Shell>
