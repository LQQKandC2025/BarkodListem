<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarkodListem.LaunchPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071C2E">
    <Grid>
        <Image x:Name="launchImage"
               Source="launch_furniture.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid VerticalOptions="End" Padding="26,90,26,34" InputTransparent="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00071C2E" Offset="0.0" />
                    <GradientStop Color="#D9071C2E" Offset="0.72" />
                    <GradientStop Color="#F5071C2E" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout x:Name="launchCaption"
                                 Spacing="5" VerticalOptions="End">
                <Label Text="MOBİL SERVİS"
                       TextColor="White" FontSize="29"
                       FontAttributes="Bold" CharacterSpacing="2.0"
                       HorizontalTextAlignment="Center" />
                <Label Text="Sevkiyat ve montaj, tek noktadan yönetim"
                       TextColor="#D5E9EC" FontSize="13"
                       HorizontalTextAlignment="Center" />
                <ActivityIndicator IsRunning="True" Color="#28C5B7"
                                   WidthRequest="24" HeightRequest="24"
                                   Margin="0,12,0,0" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
