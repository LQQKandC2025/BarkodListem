<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarkodListem.Pages.SevkiyatDetayPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6F9">
    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#58717E" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0.6" />
        </Style>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Stroke" Value="#D8E2E8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="StrokeShape"><RoundRectangle CornerRadius="13" /></Setter>
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="TextColor" Value="#173442" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="18,22,18,24" ColumnDefinitions="Auto,*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#071C2E" Offset="0" />
                    <GradientStop Color="#0C3D5B" Offset="0.62" />
                    <GradientStop Color="#087E84" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Button Text="‹" Clicked="Back_Clicked" WidthRequest="44" HeightRequest="44"
                    Padding="0,-4,0,0" CornerRadius="13" FontSize="34"
                    TextColor="White" BackgroundColor="#22FFFFFF" />
            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalOptions="Center">
                <Label Text="SEVKİYAT DETAYI" TextColor="White" FontSize="23"
                       FontAttributes="Bold" CharacterSpacing="1.2" />
                <Label Text="Teslimat ve saha bilgileri" TextColor="#CBE5EB" FontSize="12" />
            </VerticalStackLayout>
            <Border Grid.Column="2" IsVisible="{Binding IsSshSevkiyat}" Padding="11,7"
                    Stroke="#FFD166" StrokeThickness="1" BackgroundColor="#F9A825">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label Text="SSH" TextColor="#3D2B00" FontAttributes="Bold" FontSize="12" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" BackgroundColor="{Binding FormBackgroundColor}">
            <VerticalStackLayout Padding="18,18,18,30" Spacing="14">
                <Border IsVisible="{Binding IsSshSevkiyat}" Padding="15,12"
                        Stroke="#E2A917" StrokeThickness="1" BackgroundColor="#FFF1A8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Label Text="!" TextColor="#7A5200" FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="SSH SEVKİYATI" TextColor="#5F4100" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Bu kayıtta servis/hasar işlemleri bulunmaktadır."
                                   TextColor="#7A5B12" FontSize="10" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="17" Stroke="#DDE6EB" StrokeThickness="1" BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#20263849" Opacity="0.12" Radius="11" Offset="0,4" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="SEVKİYAT BİLGİLERİ" TextColor="#087E84" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1.1" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="SEVK TARİHİ" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SEVK_TARIH}" IsReadOnly="True" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="SEVKİYAT NO" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding SEVKIYAT_NO}" IsReadOnly="True" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="İŞLEM TÜRÜ" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding ISLEM_TURU}" IsReadOnly="True" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="ARAÇ PLAKA" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding ARAC_PLAKA}" IsReadOnly="True" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="17" Stroke="#DDE6EB" StrokeThickness="1" BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="TESLİMAT BİLGİLERİ" TextColor="#087E84" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1.1" />
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TESLİMAT NOTU" Style="{StaticResource FieldLabel}" />
                            <Border Padding="13,8" Style="{StaticResource FieldBorder}">
                                <Editor x:Name="TeslimNotuEditor" Text="{Binding TESLIM_NOTU}"
                                        Placeholder="Teslimat notunu yazın" PlaceholderColor="#9AABB4"
                                        TextColor="#173442" AutoSize="TextChanges" MinimumHeightRequest="82"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TESLİM ALAN" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding TESLIM_ALAN}" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TELEFON" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding TEL1}" Keyboard="Telephone" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="TESLİM ONAY KODU" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="9">
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding TESLIM_ONAY_KODU}" Style="{StaticResource FieldEntry}" />
                                </Border>
                                <Button Grid.Column="1" Text="SMS" Command="{Binding KodGonderCommand}"
                                        WidthRequest="76" CornerRadius="13" BackgroundColor="#E7F5F5"
                                        TextColor="#087E84" FontSize="11" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="MOBİL PERSONEL" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Text="{Binding MOBIL_PERSONEL}" IsReadOnly="True" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="ÜRÜNLER" Clicked="OnUrunListesiClicked" HeightRequest="54"
                            CornerRadius="15" BackgroundColor="White" TextColor="#087E84"
                            BorderColor="#B9E4E1" BorderWidth="1" FontAttributes="Bold" />
                    <Button Grid.Column="1" Text="KAYDET VE GÖNDER" Command="{Binding KaydetCommand}"
                            HeightRequest="54" CornerRadius="15" BackgroundColor="#087E84"
                            TextColor="White" FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
