<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BarkodListem.Models"
             x:Class="BarkodListem.Pages.IrsaliyeDetayPage"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False"
             BackgroundColor="#F3F6F9">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid Padding="18,22,18,24" ColumnDefinitions="Auto,*">
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#071C2E" Offset="0"/><GradientStop Color="#0C3D5B" Offset="0.62"/><GradientStop Color="#087E84" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Button Text="‹" Clicked="Back_Clicked" WidthRequest="44" HeightRequest="44" Padding="0,-4,0,0" CornerRadius="13" FontSize="34" TextColor="White" BackgroundColor="#22FFFFFF" />
            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalOptions="Center"><Label Text="İRSALİYE DETAYI" TextColor="White" FontSize="23" FontAttributes="Bold" CharacterSpacing="1.1"/><Label Text="Paket barkodlarını doğrulayın" TextColor="#CBE5EB" FontSize="12"/></VerticalStackLayout>
        </Grid>
        <Border Grid.Row="1" Margin="18,18,18,12" Padding="9,4,7,4" Stroke="#D8E2E8" StrokeThickness="1" BackgroundColor="White">
            <Border.StrokeShape><RoundRectangle CornerRadius="17"/></Border.StrokeShape><Border.Shadow><Shadow Brush="#20263849" Opacity="0.14" Radius="12" Offset="0,4"/></Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7"><Entry x:Name="barkodEntry" Placeholder="Paket barkodunu okut veya gir" PlaceholderColor="#98A7B1" TextColor="#173442" FontSize="15" Keyboard="Text" ReturnType="Done" Completed="OnEntryCompleted" TextChanged="OnEntryTextChanged" ClearButtonVisibility="WhileEditing" BackgroundColor="Transparent"/><Button Grid.Column="1" Text="TARA" Clicked="OnCameraClicked" WidthRequest="72" HeightRequest="44" CornerRadius="13" BackgroundColor="#087E84" TextColor="White" FontSize="11" FontAttributes="Bold"/></Grid>
        </Border>
        <Grid Grid.Row="2" Margin="18,0,18,8" ColumnDefinitions="*,Auto"><Label Text="Paketler" TextColor="#102A3A" FontSize="20" FontAttributes="Bold"/><Label Grid.Column="1" Text="Okutulanlar yeşil görünür" TextColor="#7B8D98" FontSize="10" VerticalTextAlignment="Center"/></Grid>
        <CollectionView Grid.Row="3" ItemsSource="{Binding PaketHareketler}" SelectionMode="None" Margin="18,0,18,8">
            <CollectionView.EmptyView><VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5"><Label Text="Paket kaydı bulunamadı" TextColor="#294654" FontSize="16" FontAttributes="Bold"/><Label Text="İrsaliye detayları servisten alınamadı veya boş." TextColor="#8797A1" FontSize="11"/></VerticalStackLayout></CollectionView.EmptyView>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="models:PaketHrkModel"><Border Margin="0,0,0,9" Padding="14" Stroke="#DDE6EB" StrokeThickness="1"><Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape><Border.Style><Style TargetType="Border"><Setter Property="BackgroundColor" Value="White"/><Style.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True"><Setter Property="BackgroundColor" Value="#DDF7E9"/><Setter Property="Stroke" Value="#72CAA0"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" BackgroundColor="#E7F5F5"><Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape><Label Text="{Binding PAKET_HRK_ID}" TextColor="#087E84" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding PAKET_ADI}" TextColor="#173442" FontSize="14" FontAttributes="Bold"/><Label Text="Paket barkodu" TextColor="#8797A1" FontSize="9"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="4" Padding="18,10,18,20"><Button Text="OKUTULANLARI KAYDET" Clicked="OnGonderClicked" HeightRequest="54" CornerRadius="15" BackgroundColor="#087E84" TextColor="White" FontAttributes="Bold"/></Grid>
    </Grid>
</ContentPage>
