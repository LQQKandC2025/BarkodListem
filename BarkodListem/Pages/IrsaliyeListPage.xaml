<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BarkodListem.ViewModels"
    xmlns:models="clr-namespace:BarkodListem.Models"
    x:Class="BarkodListem.Pages.IrsaliyeListPage"
    x:DataType="vm:IrsaliyeListViewModel"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F3F6F9">

    <ContentPage.Resources>
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="TextColor" Value="#173442" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="18,22,18,24" ColumnDefinitions="Auto,*">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#071C2E" Offset="0.0" />
                    <GradientStop Color="#0C3D5B" Offset="0.62" />
                    <GradientStop Color="#087E84" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Button Text="‹" Clicked="Back_Clicked"
                    WidthRequest="44" HeightRequest="44" Padding="0,-4,0,0"
                    CornerRadius="13" FontSize="34" TextColor="White"
                    BackgroundColor="#22FFFFFF" />
            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0"
                                 Spacing="1" VerticalOptions="Center">
                <Label Text="İRSALİYE İŞLEMLERİ" TextColor="White"
                       FontSize="23" FontAttributes="Bold" CharacterSpacing="1.1" />
                <Label Text="Tarih aralığına göre kayıtları görüntüleyin"
                       TextColor="#CBE5EB" FontSize="12" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1" Margin="18,18,18,12" Padding="16"
                Stroke="#DDE6EB" StrokeThickness="1" BackgroundColor="White">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#20263849" Opacity="0.14" Radius="12" Offset="0,5" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TARİH FİLTRESİ" TextColor="#087E84"
                               FontSize="10" FontAttributes="Bold" CharacterSpacing="1.2" />
                        <Label Text="İrsaliye arama" TextColor="#102A3A"
                               FontSize="19" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}" Color="#087E84"
                                       WidthRequest="28" HeightRequest="28" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Başlangıç" TextColor="#6C818D" FontSize="11" />
                        <Border Padding="10,0" Stroke="#D8E2E8" StrokeThickness="1"
                                BackgroundColor="#F8FAFB">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <DatePicker Date="{Binding StartDate}" Format="dd.MM.yyyy"
                                        Style="{StaticResource DatePickerStyle}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Bitiş" TextColor="#6C818D" FontSize="11" />
                        <Border Padding="10,0" Stroke="#D8E2E8" StrokeThickness="1"
                                BackgroundColor="#F8FAFB">
                            <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                            <DatePicker Date="{Binding EndDate}" Format="dd.MM.yyyy"
                                        Style="{StaticResource DatePickerStyle}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="İrsaliye numarası (isteğe bağlı)"
                               TextColor="#6C818D" FontSize="11"
                               VerticalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="2">
                            <CheckBox IsChecked="{Binding IrsaliyeNoTarihleSinirla}"
                                      Color="#087E84" Scale="0.78"
                                      VerticalOptions="Center" />
                            <Label Text="Tarihle sınırla" TextColor="#5F7582"
                                   FontSize="10" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border Padding="12,0" Stroke="#D8E2E8" StrokeThickness="1"
                            BackgroundColor="#F8FAFB">
                        <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                        <Entry x:Name="irsaliyeNoEntry" Text="{Binding IrsaliyeNo}"
                               Placeholder="Örn. IRS-014360"
                               ClearButtonVisibility="WhileEditing"
                               ReturnType="Search"
                               TextColor="#173442"
                               PlaceholderColor="#93A3AC"
                               FontAttributes="Bold"
                               HeightRequest="48"
                               Focused="IrsaliyeNoEntry_Focused"
                               TextChanged="IrsaliyeNoEntry_TextChanged" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="İRSALİYELERİ SORGULA" Clicked="IrsaliyeSorgula_Clicked"
                        HeightRequest="50" CornerRadius="14" BackgroundColor="#087E84"
                        TextColor="White" FontSize="13" FontAttributes="Bold"
                        CharacterSpacing="0.7" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Padding="18,4,18,18">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <Label Text="İrsaliyeler" TextColor="#102A3A"
                       FontSize="20" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding Irsaliyeler.Count, StringFormat='{}{0} kayıt'}"
                       TextColor="#7B8D98" FontSize="12" VerticalTextAlignment="Center" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Irsaliyeler}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Margin="0,8,0,0" Padding="24" Stroke="#DDE6EB"
                            StrokeThickness="1" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="7" HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Border WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                                    BackgroundColor="#E7F5F5" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                <Label Text="▤" TextColor="#087E84" FontSize="28"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Henüz irsaliye listelenmedi" TextColor="#294654"
                                   FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="Tarih aralığını seçip sorgulama yapın."
                                   TextColor="#8797A1" FontSize="11" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:IrsaliyeModel">
                        <Frame Margin="0,0,0,10" Padding="15" CornerRadius="18"
                               HasShadow="True" BackgroundColor="White"
                               BorderColor="#E0E8ED">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIrsaliyeTapped"
                                                      CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12" RowSpacing="8">
                                <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0" BackgroundColor="#E7F5F5"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                    <Label Text="▤" TextColor="#087E84" FontSize="23"
                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding IRS_NO}"
                                       TextColor="#102A3A" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="{Binding IRS_TARIH, StringFormat='{}{0:dd.MM.yyyy}'}"
                                       TextColor="#5F7582" FontSize="11" VerticalTextAlignment="Center" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding IRSALIYE_TURU}"
                                       TextColor="#087E84" FontSize="12" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.Column="2" Text="DETAY  ›"
                                       TextColor="#708793" FontSize="10" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
